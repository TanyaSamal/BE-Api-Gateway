{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["**/test/*.integration.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(amqp-connection-manager|promise-breaker|uuid)/)"
  ],
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "roots": ["<rootDir>"],
  "moduleNameMapper": {
    "^ai/shared(|/.*)$": "<rootDir>/../../libs/shared/src/$1"
  },
  "setupFilesAfterEnv": [],
  "testTimeout": 30000
}